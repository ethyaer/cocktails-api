  ]
}

### Zaktualizuj koktajl po ID.
PATCH http://localhost:3000/cocktails/{id}
Authorization: Bearer 
Content-Type: application/json

{
  "name": "",
  "recipe": "",
  "categoryId": ,
  "ingredients": [
    {
      "ingredientId": ,
      "amount": 
    },
    {
      "ingredientId": ,
      "amount": 
    },
    {
      "ingredientId": ,
      "amount": 
    }
  ]
}

### Usuń koktajl po ID.
DELETE http://localhost:3000/cocktails/{{cocktailId}}

